# ╔══════════════════════════════════════════════════════════════╗
# ║  CCTV Attendance Edge Server — Configuration               ║
# ║  Copy to .env and fill in your values                      ║
# ╚══════════════════════════════════════════════════════════════╝

# --- Supabase Cloud Connection ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Device Identity ---
# Unique identifier for this edge server (registered in cctv_devices table)
EDGE_DEVICE_ID=edge-server-site-alpha
EDGE_DEVICE_SECRET=your-device-secret-key

# --- Camera Configuration ---
# Comma-separated list of camera configs: name|rtsp_url|direction(entry/exit)
# Example for Hikvision: rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101
CAMERAS=gate_a_entry|rtsp://admin:pass@192.168.1.64:554/Streaming/Channels/101|entry,gate_a_exit|rtsp://admin:pass@192.168.1.65:554/Streaming/Channels/101|exit

# --- Recognition Settings ---
# Cosine similarity threshold (0.0 - 1.0). Higher = stricter matching.
MATCH_THRESHOLD=0.45
# Minimum face detection confidence (0.0 - 1.0)
MIN_DETECTION_CONFIDENCE=0.5
# Cooldown in seconds — same person won't be re-detected for this period
COOLDOWN_SECONDS=300
# Frame processing rate (FPS). Lower = less CPU. 2-5 recommended for CPU-only.
PROCESSING_FPS=3

# --- Local Server ---
# Port for local admin API/dashboard
ADMIN_PORT=4100
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Snapshot Storage ---
# Save snapshots of detected faces (for proof/audit)
SAVE_SNAPSHOTS=true
SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_DIR=./snapshots

# --- Offline Queue ---
# Max events to buffer when internet is down
MAX_OFFLINE_QUEUE_SIZE=1000
