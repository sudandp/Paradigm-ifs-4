# ═══════════════════════════════════════════════════════════════
#  Paradigm Attendance API — Environment Configuration
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Port this API listens on (keep 4000, cloudflared will tunnel it)
PORT=4000

# ── SQL Server (connects locally — never exposed to internet) ──
DB_NAME=etimetracklite1
DB_USER=sa
DB_PASSWORD=Paradigm@1610
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_TRUSTED=false

# ── Security ───────────────────────────────────────────────────
# This must match MSSQL_API_SECRET in your Vercel environment variables
API_SECRET=paradigm-attendance-secret-2024

# ── Supabase Sync (MS SQL → Supabase Cache) ────────────────────
# Keeps attendance data in Supabase so frontend works offline
# Service role key required — never expose this to the browser
