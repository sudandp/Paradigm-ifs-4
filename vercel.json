{
  "rewrites": [
    { "source": "/api/cctv-proxy", "destination": "/api/cctv-proxy" },
    { "source": "/api/cctv-frame", "destination": "/api/cctv-proxy?action=frame" },
    { "source": "/api/mssql-attendance", "destination": "/api/mssql?action=attendance" },
    { "source": "/api/mssql-devices", "destination": "/api/mssql?action=devices" },
    { "source": "/api/mssql-update-employee", "destination": "/api/mssql?action=update-employee" },
    { "source": "/api/groq-summarise", "destination": "/api/groq?action=summarise" },
    { "source": "/api/groq-transcribe", "destination": "/api/groq?action=transcribe" },
    { "source": "/api/view-file/(.*)", "destination": "/api/view-file?path=$1" },
    { "source": "/api/hrm/(.*)", "destination": "/api/hrm" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
